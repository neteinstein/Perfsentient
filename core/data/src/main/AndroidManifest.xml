<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Special access granted by the user in Settings > Usage access.
         Needed for per-app foreground/background time, usage events, network and storage stats. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Core purpose of the app is auditing installed apps for misbehaviour (security/antivirus-like
         use case). Requires the Play Console "Package visibility" declaration. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Optional, never requested at runtime: development permissions the user can grant with
         `adb shell pm grant <package> <permission>`. Only used to read the system error log
         (DropBox) for app ANR / crash counts; the app degrades gracefully without them.
         Android 14 and older check READ_LOGS; Android 15+ checks READ_DROPBOX_DATA instead for
         apps targeting it (when the platform's enable_read_dropbox_permission flag is on). -->
    <uses-permission
        android:name="android.permission.READ_LOGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.READ_DROPBOX_DATA"
        tools:ignore="ProtectedPermissions" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>
</manifest>
